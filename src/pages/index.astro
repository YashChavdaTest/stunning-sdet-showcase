---
import '../styles/global.css';
import Header from '../components/Header.astro';
import ContactFooter from '../components/ContactFooter.astro';
import '@fontsource/bebas-neue/latin-400.css';
import '@fontsource/caveat/latin-400.css';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
const jobs = [['2017–19','Operations & UAT','Numerator','Production validation, defects, release quality.'],['2019–21','Software QA','Stemmons','Helped move manual QA toward Java/TestNG automation.'],['2021–23','Senior SDET','IMRIEL','Cypress, APIs, mobile testing and CI.'],['2023–NOW','QA Lead / Architect','IMRIEL / Allata','Automation strategy, AI QA and team leadership.']];
const skills = [['Test automation','Playwright · Selenium · Cypress · PyTest · BDD · POM · Appium'],['API & integration','REST Assured · RestSharp · Postman · Karate · Kafka · contract checks'],['Performance & delivery','K6 · JMeter · Grafana · Azure DevOps · Jenkins · Allure'],['AI-assisted quality','RAG · Azure AI Search · OpenAI · MCP · agent workflows · evals']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Yash Chavda is an SDET and QA architect building trustworthy quality systems, automation and AI-assisted testing."/><meta name="theme-color" content="#f8f0e2"/><title>Yash Chavda — Quality Engineered</title></head><body>
<a class="skip" href="#main">Skip to content</a><Header />
<main id="main"><section class="hero wrap" id="top"><div class="hero-copy"><div class="eyebrow"><span>01 / THE PERSON BEHIND THE TESTS</span><span>2026 EDITION</span></div><p class="script">hello, I’m</p><h1>YASH CHAVDA<span class="red">.</span></h1><p class="hero-role">SDET / TEST AUTOMATION ARCHITECT / QA LEAD</p><div class="hero-rule"></div><p class="hero-intro">I build test systems that help teams change software quickly, without losing sight of what actually matters.</p><div class="hero-values"><span>AUTOMATION FIRST</span><span>EVIDENCE ALWAYS</span></div><a class="scroll-cue" href="#about"><span class="circle-arrow">↓</span> GET TO KNOW ME</a></div><div class="hero-art"><div class="portrait-frame"><img class="hero-portrait" src="/yash-chavda-portrait.jpg" alt="Yash Chavda wearing a light blazer" width="1200" height="911" fetchpriority="high" /></div><span class="art-stamp">QUALITY &gt; GUESSWORK</span><span class="art-spark" aria-hidden="true">✳</span></div><div class="hero-bottom"><span>YASH CHAVDA / SDET PORTFOLIO</span><span>BUILDER / MENTOR / CURIOUS TESTER</span></div></section>
<section class="about-section section" id="about"><div class="wrap"><div class="section-top"><span class="section-label">02 / THE STORY SO FAR</span><span class="section-label">A LITTLE ABOUT ME ↗</span></div><div class="about-grid"><div><p class="script">introduce</p><h2>ABOUT ME<span class="red">.</span></h2><p class="body-large">I started in 2017 on the operations side of software, got curious about why things break, and kept moving closer to the engineering.</p><p class="body-large">Today I lead QA strategy, design automation platforms and explore how AI can make the testing loop smarter.</p></div><div class="identity"><div class="identity-inner"><div class="monogram">YC</div><div class="identity-line"></div><strong>YASH<br/>CHAVDA</strong></div><span>BUILDER / MENTOR / CURIOUS TESTER</span></div></div><a class="section-next" href="#philosophy" aria-label="Continue to working philosophy"><span aria-hidden="true">↓</span></a></div></section>
<section class="philosophy section" id="philosophy"><div class="wrap"><div class="section-top"><span class="section-label">03 / WORKING PHILOSOPHY</span><span class="section-label">THE WAY I THINK</span></div><div class="philosophy-grid"><article><p class="script">vision</p><h2>QUALITY IS<br/>A SYSTEM<span class="red">.</span></h2><p>The best QA is not a final checkpoint. It is a continuous feedback system built into how teams design, code and release.</p><span class="pill">LESS REWORK</span></article><article><p class="script">mission</p><h2>MAKE SIGNAL<br/>ACTIONABLE<span class="red">.</span></h2><p>Automate repetitive checks, investigate the difficult edges, and put trustworthy evidence in front of the people making decisions.</p><span class="pill teal-pill">MORE CONFIDENCE</span></article></div><a class="section-next" href="#experience" aria-label="Continue to experience"><span aria-hidden="true">↓</span></a></div></section>
<section class="section wrap" id="experience"><div class="section-top"><span class="section-label">04 / CAREER JOURNEY</span><span class="section-label">2017 — <span class="current-year">PRESENT</span></span></div><p class="script">work</p><h2>EXPERIENCE<span class="red">.</span></h2><p class="section-lead">From frontline UAT to leading quality architecture and AI-assisted test engineering.</p><div class="timeline"><div class="timeline-line" aria-hidden="true"><div class="timeline-progress"></div></div>{jobs.map((job,i)=><article class:list={["job", {"job-current": i === jobs.length - 1}]}><span class="job-date">{job[0]}</span><span class={`job-marker marker-${i}`} aria-hidden="true"></span><div class="job-content">{i === jobs.length - 1 && <span class="current-label">CURRENT / <span class="current-year">PRESENT</span></span>}<h3>{job[1]}</h3><p class="job-company">{job[2]}</p><p>{job[3]}</p></div></article>)}</div><a class="section-next" href="#skills" aria-label="Continue to skills"><span aria-hidden="true">↓</span></a></section>
<section class="section capabilities" id="skills"><div class="wrap"><div class="section-top"><span class="section-label">05 / CAPABILITIES</span><span class="section-label">THE TOOLKIT</span></div><div class="skills-layout"><div><p class="script">personal</p><h2>SKILLS<span class="red">.</span></h2><p class="section-lead">Good tooling is invisible when it works. Good architecture keeps it working.</p></div><div class="skills-list">{skills.map((skill,i)=><article><span class="skill-number">0{i+1}</span><div><h3>{skill[0]}</h3><p>{skill[1]}</p></div><span class="skill-plus">↗</span></article>)}</div></div><a class="section-next" href="#leadership" aria-label="Continue to leadership"><span aria-hidden="true">↓</span></a></div></section>
<section class="section wrap" id="leadership"><div class="section-top"><span class="section-label">06 / BEYOND THE FRAMEWORK</span><span class="section-label">THE HUMAN SIDE</span></div><p class="script">the human side</p><h2>LEADERSHIP IS<br/>A QA TOOL<span class="red">.</span></h2><p class="section-lead">Strong automation is a team habit, not a repository that only one person understands.</p><div class="three-grid"><article><span>01</span><h3>MAKE IT LEGIBLE</h3><p>Clear ownership, reviewable code, useful reporting and visible quality risks.</p></article><article><span>02</span><h3>GROW THE TEAM</h3><p>Mentoring, pair reviews, QA bootcamps and faster onboarding to new tools.</p></article><article><span>03</span><h3>SHAPE DECISIONS</h3><p>Work with engineering and product to balance speed, coverage and confidence.</p></article></div><a class="section-next" href="#education" aria-label="Continue to education"><span aria-hidden="true">↓</span></a></section>
<section class="education section" id="education"><div class="wrap"><div class="section-top"><span class="section-label">07 / EDUCATION & CREDENTIALS</span><span class="section-label">ALWAYS LEARNING</span></div><div class="education-grid"><div><p class="script">always learning</p><h2>THE<br/>FOUNDATIONS<span class="red">.</span></h2><p class="section-lead">Education and ongoing learning behind the work.</p></div><div class="credentials"><div><b>01</b><p><strong>B.E. / INFORMATION TECHNOLOGY</strong>Gujarat Technological University · 2018–2021</p></div><div><b>02</b><p><strong>DIPLOMA / INFORMATION TECHNOLOGY</strong>MSU Polytechnic · 2014–2017</p></div><div><b>03</b><p><strong>TESTING & DELIVERY</strong>ISTQB CTFL · Scrum Master · Cypress 101</p></div><div><b>04</b><p><strong>AI-ORIENTED PRACTICE</strong>Claude Certified Architect · Foundation & Professional</p></div></div></div><a class="section-next" href="#contact" aria-label="Continue to contact"><span aria-hidden="true">↓</span></a></div></section>
<ContactFooter /></main>
<script>
import gsap from 'gsap'; import { ScrollTrigger } from 'gsap/ScrollTrigger'; import Lenis from 'lenis';
document.querySelectorAll('.current-year').forEach(el => { el.textContent = String(new Date().getFullYear()); });
gsap.registerPlugin(ScrollTrigger); const motion = window.matchMedia('(prefers-reduced-motion: no-preference)'); let cleanup: (() => void) | undefined;
function setup() { cleanup?.(); cleanup = undefined; if (!motion.matches) return; const lenis = new Lenis({ anchors: false, autoRaf: false }); const onAnchorClick = (event: MouseEvent) => { if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return; const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"], a[href^="/#"]'); if (!link || link.classList.contains('skip')) return; const hash = new URL(link.href).hash; if (!hash || hash === '#') return; const target = document.getElementById(decodeURIComponent(hash.slice(1))); if (!target) return; event.preventDefault(); const menu = link.closest('details'); if (menu) menu.open = false; if (location.hash !== hash) history.pushState(null, '', hash); lenis.scrollTo(target, { duration: 1.2 }); }; document.addEventListener('click', onAnchorClick); const tick = (time: number) => lenis.raf(time * 1000); lenis.on('scroll', ScrollTrigger.update); gsap.ticker.add(tick); const context = gsap.context(() => { if (window.matchMedia('(min-width: 701px)').matches) gsap.fromTo('.timeline-progress', { scaleX: 0 }, { scaleX: 1, duration: 1.1, ease: 'power2.out', scrollTrigger: { trigger: '#experience', start: 'top 75%', once: true } }); gsap.utils.toArray<HTMLElement>('.case-visual, .identity, .hero-art').forEach(el => gsap.fromTo(el, { y: 20 }, { y: -20, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } })); }); cleanup = () => { document.removeEventListener('click', onAnchorClick); context.revert(); gsap.ticker.remove(tick); lenis.destroy(); }; } setup(); motion.addEventListener('change', setup); window.matchMedia('(min-width: 701px)').addEventListener('change', setup);
</script></body></html>
